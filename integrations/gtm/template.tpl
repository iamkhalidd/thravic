___TESTS___

scenarios:
- name: Loads the tracker with the tracking ID
  code: |-
    runCode({trackingId: 'TF-2083C319'});

    assertThat(injectedUrl).isEqualTo('https://api.thravic.com/tf.js');
    assertThat(win.__TF_ID__).isEqualTo('TF-2083C319');
    assertApi('gtmOnSuccess').wasCalled();
- name: Leaves __TF_CONFIG__ alone when every option is on the default
  code: |-
    runCode({trackingId: 'TF-2083C319', trackClicks: '', trackRecordings: '', clickTextMaxLength: ''});

    assertThat(win.__TF_CONFIG__).isUndefined();
    assertApi('gtmOnSuccess').wasCalled();
- name: Passes the chosen options to the tracker
  code: |-
    runCode({
      trackingId: 'TF-2083C319',
      trackRecordings: 'on',
      requireConsent: 'on',
      trackClicks: 'off',
      trackScrolls: '',
      clickTextMaxLength: '0'
    });

    assertThat(win.__TF_CONFIG__).isEqualTo({
      trackRecordings: true,
      requireConsent: true,
      trackClicks: false,
      clickTextMaxLength: 0
    });
- name: Keeps options the page set itself
  code: |-
    pageConfig = {feedbackWidget: true, trackClicks: true};
    runCode({trackingId: 'TF-2083C319', trackClicks: 'off'});

    assertThat(win.__TF_CONFIG__).isEqualTo({feedbackWidget: true, trackClicks: false});
- name: Reports failure when the tracker cannot load
  code: |-
    injectFails = true;
    runCode({trackingId: 'TF-2083C319'});

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: |-
  let injectedUrl;
  let injectFails = false;
  let pageConfig;
  const win = {};

  mock('injectScript', function (url, onSuccess, onFailure) {
    injectedUrl = url;
    if (injectFails) {
      onFailure();
    } else {
      onSuccess();
    }
  });
  mock('setInWindow', function (key, value) {
    win[key] = value;
    return true;
  });
  mock('copyFromWindow', function (key) {
    return key === '__TF_CONFIG__' ? pageConfig : undefined;
  });


