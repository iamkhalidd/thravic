___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Loads the same tracker as the dashboard's snippet:
//   <script async src="https://api.thravic.com/tf.js" data-tracking-id="TF-..."></script>
// A sandboxed template cannot set data-tracking-id on the script it injects, so
// the ID goes in window.__TF_ID__, which the tracker reads first.
const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const copyFromWindow = require('copyFromWindow');
const makeNumber = require('makeNumber');
const getType = require('getType');

const TRACKER_URL = 'https://api.thravic.com/tf.js';
const SWITCHES = [
  'trackClicks', 'trackScrolls', 'trackForms', 'trackErrors', 'trackPerformance',
  'trackRecordings', 'respectDoNotTrack', 'requireConsent'
];

// Options the page already set in window.__TF_CONFIG__ stay; this tag's choices win.
const existing = copyFromWindow('__TF_CONFIG__');
const config = getType(existing) === 'object' ? existing : {};
let changed = false;

SWITCHES.forEach(function (key) {
  if (data[key] === 'on') {
    config[key] = true;
    changed = true;
  } else if (data[key] === 'off') {
    config[key] = false;
    changed = true;
  }
});

if (data.clickTextMaxLength !== undefined && data.clickTextMaxLength !== '') {
  config.clickTextMaxLength = makeNumber(data.clickTextMaxLength);
  changed = true;
}

if (changed) {
  setInWindow('__TF_CONFIG__', config, true);
}
setInWindow('__TF_ID__', data.trackingId, true);

injectScript(TRACKER_URL, data.gtmOnSuccess, data.gtmOnFailure, 'thravic');


