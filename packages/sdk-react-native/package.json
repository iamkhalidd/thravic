{
  "name": "@thravic/react-native",
  "version": "0.1.0",
  "description": "Thravic analytics for React Native and Expo apps: screens, sessions and custom events.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md"
  ],
  "keywords": [
    "analytics",
    "react-native",
    "expo",
    "thravic"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "react-native": "^0.76.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
