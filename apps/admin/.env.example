# ──────────────────────────────────────────────
# Thravic Admin — Environment Variables
# ──────────────────────────────────────────────
# Copy to `.env.local` and adjust:
#   Copy-Item .env.example .env.local
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time,
# so changing this requires a rebuild (or a redeploy on Vercel).
# ──────────────────────────────────────────────

# Base URL of the Thravic API. Falls back to http://localhost:3001
# when unset.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public URL of the Thravic *web* app (not this admin panel). Used by
# "impersonate user" to open the impersonated session. Falls back to
# http://localhost:3000 when unset, so it MUST be set for production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Security (server-only: no NEXT_PUBLIC_ prefix, never sent to the browser) ──

# The API address as this panel's server sees it. Sign-in and every admin call
# go through this panel's own server, which keeps the session in httpOnly
# cookies. Falls back to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:3001

# Optional. A long random string, set to the SAME value on the API (Render).
# With it set, the API refuses admin calls that did not come through this
# panel, so the IP allowlist below cannot be skipped by calling the API directly.
ADMIN_PROXY_SECRET=

# Optional. Comma-separated IP addresses or IPv4 ranges allowed to open the
# panel, e.g. "102.89.34.10, 197.210.0.0/16". Empty means anyone can reach the
# sign-in page (the password and authenticator code still apply).
ADMIN_ALLOWED_IPS=
