# ──────────────────────────────────────────────
# Thravic API (FastAPI) — Environment Variables
# ──────────────────────────────────────────────
# These names deliberately match the Express backend exactly, so the same
# deployment environment works for both during the migration.
#
# Copy to `.env` and fill in real values:
#   Copy-Item .env.example .env
# ──────────────────────────────────────────────

# ── Runtime ───────────────────────────────────
NODE_ENV=development
PORT=3001

# error | warn | info | debug
LOG_LEVEL=info

# Serve Swagger UI (/docs) + /openapi.json. On by default; set false to hide.
DOCS_ENABLED=true

# ── Database ──────────────────────────────────
# REQUIRED
DATABASE_URL=postgresql://postgres:thravic@localhost:5432/thravic

# ── Cache / rate limiting ─────────────────────
# Optional. Falls back to in-memory when unset.
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────
# REQUIRED in production. MUST be the same values as the Express backend so
# tokens issued by either server remain valid across the cutover.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Origins ───────────────────────────────────
# Comma-separated whitelist. Drives CORS, the CSP connect-src policy, and the
# redirect allowlist. Must contain both frontends.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# The customer-facing frontend. Used for OAuth callback redirects, the Paystack
# return URL, and links inside transactional emails.
FRONTEND_URL=http://localhost:3000

# Public URL of this API, used to build the tracker embed URL and the OAuth
# redirect_uri. SERVER_URL (falling back to API_URL) is also substituted into
# the served tracker's `${apiUrl}` placeholder, i.e. where its events POST to.
SERVER_URL=http://localhost:3001
API_URL=http://localhost:3001

# ── Rate limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Demo mode ─────────────────────────────────
DEMO_MODE=false

# ── Billing (Paystack) ────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Thravic <onboarding@resend.dev>

# ── OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI insights ───────────────────────────────
GEMINI_API_KEY=
