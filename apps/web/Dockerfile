# ──────────────────────────────────────────────
# Thravic Web — Standalone Image
# Build context: apps/web (this directory)
#
#   docker build -t thravic-web .
#
# Requires `output: 'standalone'` in next.config.js, which is set.
# Vercel ignores that option, so the same config works for both targets.
# ──────────────────────────────────────────────

# ── Stage 1: Build ────────────────────────────
FROM node:18-alpine AS builder

WORKDIR /app

# Install dependencies (lockfile-driven, reproducible)
COPY package.json package-lock.json ./
RUN npm ci

# Copy source (node_modules and .next excluded via .dockerignore)
COPY . .

ENV NEXT_TELEMETRY_DISABLED 1
RUN npm run build

# ── Stage 2: Production ───────────────────────
FROM node:18-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED 1

RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

# Static assets and the standalone server bundle
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# server.js is generated by Next.js standalone output
CMD ["node", "server.js"]
