# Server Configuration
PORT=10000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://user:password@host:5432/trackflow
REDIS_URL=redis://localhost:6379

# Security (Generate strong random strings for production)
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
# Access token expiry (e.g. 15m, 1h)
JWT_EXPIRES_IN=15m
# Refresh token expiry (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=https://your-app.vercel.app

# Frontend URL — used by Paystack redirect callbacks
FRONTEND_URL=https://your-app.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Paystack (https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_live_...
# Webhook secret — use the same value as PAYSTACK_SECRET_KEY for HMAC verification
PAYSTACK_WEBHOOK_SECRET=sk_live_...

# Email Service (Optional - for Alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=...
EMAIL_FROM=noreply@your-domain.com
